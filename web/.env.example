# URL de produção do pm-board (o servidor de login/OAuth que essa app usa)
PMBOARD_BASE_URL=https://SEU-PMBOARD.vercel.app

# Preenchido depois de registrar esta app como cliente OAuth no pm-board
OAUTH_CLIENT_ID=

# URL pública desta própria app depois do deploy (o Railway/Render mostra isso)
APP_BASE_URL=https://SEU-APP.up.railway.app

# Qualquer string aleatória longa — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# O mesmo valor configurado como "secret" ao criar o webhook no painel da
# Cakto (Configurações > Webhooks) — vem dentro do corpo de cada evento que
# ela manda (campo "secret" na raiz do JSON), não é assinatura HMAC.
CAKTO_WEBHOOK_SECRET=
